digraph G {
  rankdir=LR;
  node [shape=box, style="rounded", fontname="Arial"];
  Backend -> Prometheus [label="metrics"];
  Inventory -> Prometheus [label="metrics"];
  Containers -> Alloy [label="stdout/logs"];
